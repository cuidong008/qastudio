# 应用
APP_NAME=计算机网络基础课程智能体
DEBUG=false
# 静态文件目录（可选）。不设则用 backend/static；部署时可设绝对路径，如 /var/www/qastudio/static
# STATIC_DIR=

# 数据库（默认 SQLite，生产可改为 PostgreSQL 等）
DATABASE_URL=sqlite+aiosqlite:///./qastudio.db

# 认证（生产环境务必更换）
SECRET_KEY=change-me-in-production

# 跨域（前端开发地址）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# 通过本机 IP 访问时取消下行注释，允许任意 Origin（仅本地/内网）
# CORS_ORIGIN_REGEX=https?://.*

# PDF 解析（扫描版建议 MinerU）
PDF_PARSE_ENGINE=pypdf
MINERU_LANG=ch
MINERU_BACKEND=pipeline
MINERU_SOURCE=huggingface
MINERU_METHOD=auto
MINERU_DEVICE=cpu
MINERU_VRAM=1
RAG_EMBEDDING_EXTERNAL_BATCH_SIZE=10

# 生成习题页「题目类型配置」表格默认值（可选，不配置则用代码默认）
# EXERCISE_DEFAULT_SINGLE_CHOICE_MAX=10
# EXERCISE_DEFAULT_MULTIPLE_CHOICE_MAX=10
# EXERCISE_DEFAULT_JUDGE_MAX=10
# EXERCISE_DEFAULT_BLANK_MAX=10
# EXERCISE_DEFAULT_QA_MAX=5
# EXERCISE_DEFAULT_DIFFICULTY=0.8

# 生成试卷页「题型数量&难度配置」表格默认值（可选，不配置则用代码默认）
# PAPER_DEFAULT_SINGLE_CHOICE_COUNT=10
# PAPER_DEFAULT_MULTIPLE_CHOICE_COUNT=10
# PAPER_DEFAULT_JUDGE_COUNT=10
# PAPER_DEFAULT_BLANK_COUNT=10
# PAPER_DEFAULT_QA_COUNT=5
# PAPER_DEFAULT_DIFFICULTY=0.8
# PAPER_DEFAULT_SINGLE_CHOICE_SCORE=2
# PAPER_DEFAULT_MULTIPLE_CHOICE_SCORE=4
# PAPER_DEFAULT_JUDGE_SCORE=1
# PAPER_DEFAULT_BLANK_SCORE=2
# PAPER_DEFAULT_QA_SCORE=10

# Hugging Face 镜像（仅影响 RAG「程序自带」Embedding 从 HF 下载模型，国内可设）
# RAG_HF_ENDPOINT=https://hf-mirror.com
