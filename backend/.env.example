# 应用
APP_NAME=计算机网络基础课程智能体
DEBUG=false

# 数据库（默认 SQLite，生产可改为 PostgreSQL 等）
DATABASE_URL=sqlite+aiosqlite:///./qastudio.db

# 认证（生产环境务必更换）
SECRET_KEY=change-me-in-production

# 跨域（前端开发地址）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# PDF 解析（扫描版建议 MinerU）
PDF_PARSE_ENGINE=pypdf
MINERU_LANG=ch
MINERU_BACKEND=pipeline
MINERU_SOURCE=huggingface
MINERU_METHOD=auto
MINERU_DEVICE=cpu
MINERU_VRAM=1
RAG_EMBEDDING_EXTERNAL_BATCH_SIZE=10
